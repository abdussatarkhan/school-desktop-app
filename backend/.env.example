PORT=4000
# Postgres connection string. For local dev, run a free Postgres instance
# (Render/Neon/Supabase) and paste its "External Connection String" here.
DATABASE_URL="postgresql://user:password@host:5432/dbname"
JWT_SECRET="change_this_to_a_long_random_string"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:5173"
